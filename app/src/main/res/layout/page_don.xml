<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/page_association_header"
        android:id="@+id/header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/TitleMontantDon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choisissez_le_montant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        android:textSize="23sp"
        android:textStyle="bold"
        android:layout_marginStart="10dp"

         />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/TitleMontantDon"
        android:gravity="center"
        android:id="@+id/sectionMontant"

        >
        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="25dp"
                android:layout_weight="1"
                android:text="20€"
                android:textColor="@color/text_svg_main_color"
                android:textSize="16sp"
                app:cornerRadius="15dp"
                android:backgroundTint="@color/button_don_color"

                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/button2"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="40 €"
                android:textSize="16sp"
                android:layout_weight="1"
                android:layout_marginHorizontal="25dp"
                app:layout_constraintWidth_percent="0.35"
                app:cornerRadius="15dp"
                android:textColor="@color/text_svg_main_color"
                android:backgroundTint="@color/button_don_color"
                tools:ignore="HardcodedText" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            >

            <EditText
                android:id="@+id/editTextNumberSigned"
                android:layout_width="300dp"
                android:layout_height="48dp"
                android:background="@drawable/background_inputtext_page_don"
                android:ems="10"
                android:gravity="center"
                android:hint="@string/montant_libre"
                android:importantForAutofill="no"
                android:inputType="numberSigned"
                android:textColorHint="@color/text_svg_main_color"

                />

            <TextView
                android:id="@+id/Euro"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:background="@drawable/backgournd_inputtext_page_don_euro"
                android:gravity="center"
                android:text="€"
                android:textColor="#7B1FA2"
                android:textSize="18sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/barChoisirMontant"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintTop_toBottomOf="@id/sectionMontant"
        android:background="@color/text_svg_main_color"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:id="@+id/titleTotalDuDon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/total_du_don"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:textSize="23sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barChoisirMontant" />


    <TextView
        android:id="@+id/montantTotalDon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/nom_asso_00_00"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/titleTotalDuDon"
        app:layout_constraintTop_toBottomOf="@+id/titleTotalDuDon" />

    <TextView
        android:id="@+id/donPourAsso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/don_pour_nom_association"
        android:textSize="20sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@+id/montantTotalDon"
        app:layout_constraintTop_toBottomOf="@+id/montantTotalDon" />

    <View
        android:id="@+id/barTotalDuDon"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintTop_toBottomOf="@id/buttonValideDon"
        android:background="@color/text_svg_main_color"
        android:layout_marginTop="20dp"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonValideDon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_button"
        android:text="@string/je_valide_mon_don"
        android:textColor="@color/text_svg_main_color"
        android:textSize="18sp"
        app:backgroundTint="@null"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="60dp"
        app:layout_constraintTop_toBottomOf="@+id/donPourAsso"
 />

    <include layout="@layout/bottom_nav"
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>