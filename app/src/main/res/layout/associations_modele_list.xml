<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="5dp">


    <ImageButton
        android:id="@+id/iconAssociation"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/associations_round_icon"
        android:contentDescription="@string/association_icon"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/NomAssociationList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="France asso sante"
        app:layout_constraintBottom_toBottomOf="@id/barListAssociation"
        app:layout_constraintStart_toEndOf="@+id/iconAssociation"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="25dp"
        android:textSize="20sp"
        tools:ignore="HardcodedText" />

    <View
        android:id="@+id/barListAssociation"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/gris"
        app:layout_constraintTop_toBottomOf="@id/iconAssociation"
        android:layout_marginBottom="10dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>
