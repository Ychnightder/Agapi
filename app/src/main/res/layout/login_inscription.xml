<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/viewLeft"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/couleur_gradient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5" />

    <View
        android:id="@+id/viewRight"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/couleur_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5"
        android:visibility="gone"
        />


    <Button
        android:id="@+id/titleInscription"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:backgroundTint="#00FFFFFF"
        android:text="Inscription"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/titlebuttonConnexion"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5"
        android:clickable="true"
        android:focusable="true"
        />


    <Button
        android:id="@+id/titlebuttonConnexion"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:backgroundTint="#00FFFFFF"
        android:text="Connection"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/titleInscription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5"
        android:clickable="true"
        android:focusable="true"
        />

    <include
        android:id="@+id/footerauthentification"
        layout="@layout/footerauthentification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <FrameLayout
        android:id="@+id/frameContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/titlebuttonConnexion"
        app:layout_constraintBottom_toTopOf="@id/footerauthentification"
        >
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>