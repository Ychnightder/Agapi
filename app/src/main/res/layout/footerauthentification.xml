<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/zonefooter"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/couleur_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        >
    </View>
    <Button
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="#00FFFFFF"
        app:layout_constraintTop_toTopOf="@id/zonefooter"
        app:layout_constraintBottom_toBottomOf="@id/zonefooter"
        >
    </Button>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/zonefooter"
        app:layout_constraintBottom_toBottomOf="@id/zonefooter"
        android:gravity="center"
        >


        <ImageView
            android:id="@+id/imageViewRetourn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/zonefooter"
            app:srcCompat="@mipmap/icon_retourn"
            android:layout_marginEnd="20dp"
            />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Retour"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="30sp"
            android:layout_marginTop="2dp"
            />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>