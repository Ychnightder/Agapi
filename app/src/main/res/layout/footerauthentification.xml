<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/zonefooter"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/couleur_gradient"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/buttonRetourn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="#00FFFFFF"
        android:contentDescription="@string/retour"
        app:layout_constraintBottom_toBottomOf="@id/zonefooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/zonefooter"
        tools:ignore="DuplicateSpeakableTextCheck" />

    <TextView
        android:id="@+id/textViewRetour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins"
        android:text="@string/retour"
        android:textColor="@color/text_svg_main_color"
        android:textSize="30sp"
        android:textStyle="bold"
        app:drawableStartCompat="@mipmap/icon_retourn"
        android:drawablePadding="20dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="@id/zonefooter"
        app:layout_constraintStart_toStartOf="@id/zonefooter"
        app:layout_constraintEnd_toEndOf="@id/zonefooter"
        app:layout_constraintTop_toTopOf="@id/zonefooter"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>