<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.RegisterActivity">


    <include layout="@layout/headerinscription"
        android:id="@+id/header"/>

    <ImageView
        android:id="@+id/imageViewEmail"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="30dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="150dp"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/mail"
        />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="270dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewEmail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp"
        app:srcCompat="@drawable/asterisque"
        android:id="@+id/asterisqueemail"
        />

    <EditText
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/imageViewEmail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageViewEmail"
        app:layout_constraintTop_toTopOf="@id/imageViewEmail"


        />

    <ImageView
        android:id="@+id/imageViewTelephone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="25dp"
        app:layout_constraintStart_toStartOf="@id/imageViewEmail"
        app:layout_constraintTop_toBottomOf="@id/imageViewEmail"
        app:srcCompat="@drawable/telephone_1"
        app:layout_constraintEnd_toEndOf="@id/imageViewEmail"

        />


    <EditText
        android:layout_width="300dp"
        android:layout_height="wrap_content"

        android:hint="N° de Telephone"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/imageViewTelephone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageViewTelephone"
        app:layout_constraintTop_toTopOf="@id/imageViewTelephone"


        />

    <ImageView
        android:id="@+id/imageViewlocked_computer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        app:layout_constraintStart_toStartOf="@id/imageViewTelephone"
        app:layout_constraintTop_toBottomOf="@id/imageViewTelephone"
        app:layout_constraintEnd_toEndOf="@id/imageViewTelephone"
        app:srcCompat="@drawable/locked_computer_1" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="270dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewlocked_computer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp"
        app:srcCompat="@drawable/asterisque" />

    <EditText
        android:id="@+id/editTextMdp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="Mot de passe"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/imageViewlocked_computer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageViewTelephone"
        app:layout_constraintTop_toTopOf="@id/imageViewlocked_computer" />


    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/rounded_asso"
        app:layout_constraintBottom_toBottomOf="@id/buttonInscription"
        app:layout_constraintEnd_toEndOf="@id/buttonInscription"
        app:layout_constraintStart_toStartOf="@id/buttonInscription"
        app:layout_constraintTop_toTopOf="@id/buttonInscription"
        >
    </View>

    <Button
        android:id="@+id/buttonInscription"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="200dp"
        android:background="#00FFFFFF"
        android:text="Creer un compte"
        android:textSize="18dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />



    <View
        android:id="@+id/zonefooter"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_weight="0.5"
        android:background="@drawable/gradient_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        >
    </View>





    <TextView
        android:id="@+id/ou"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins"
        android:text="ou"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/buttonInscription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <View
        android:id="@+id/barrie"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_margin="20dp"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ou">
    </View>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/ou"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="50dp"
        android:gravity="center"
        >

        <ImageView
            android:id="@+id/icon_google"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"



            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/googlepng"
            />

        <TextView
            android:id="@+id/textconnectionGoogle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Se connecter avec google"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            >

        </TextView>


    </LinearLayout>

    <include layout="@layout/footerconnectioninscription" />
    <!--    &lt;!&ndash;    fin footer&ndash;&gt;-->
</androidx.constraintlayout.widget.ConstraintLayout>